<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DurationActivity">

    <TextView
        android:id="@+id/txtAddTutorial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/holo_orange_light"
        android:gravity="center"
        android:text="Verify Your Tutorial!"
        android:textColor="@android:color/black"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/stepD"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/instructions2"
        app:layout_constraintEnd_toEndOf="@+id/txtAddTutorial"
        app:layout_constraintStart_toStartOf="@+id/txtAddTutorial"
        app:layout_constraintTop_toBottomOf="@+id/txtAddTutorial" />

    <WebView
        android:id="@+id/webTutorial"
        android:layout_width="316dp"
        android:layout_height="180dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="@+id/stepD"
        app:layout_constraintStart_toStartOf="@+id/stepD"
        app:layout_constraintTop_toBottomOf="@+id/stepD" />

    <Button
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnTryagain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:onClick="gobackSearch"
        android:text="TRY AGAIN"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/webTutorial" />

</android.support.constraint.ConstraintLayout>